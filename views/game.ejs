<!-- Contenedor principal -->
<div class="mainDiv animate__animated animate__fadeIn">

    <!-- Show the word -->
    <div class="word">
        <h1 id="word">
        </h1>
    </div>

    <!-- Articles options -->
    <form class="formDiv" action="/checkAnswer" method="POST">

        <!-- first article der -->
        <div class="articleDiv">
            <button type="button" name="answer" value="der" id="maskulin">
                <h2>Der</h2>
            </button>
        </div>

        <!-- second article die -->
        <div class="articleDiv">
            <button type="button" name="answer" value="die" id="femminin">
                <h2>Die</h2>
            </button>
        </div>

        <!-- third article das -->
        <div class="articleDiv">
            <button type="button" name="answer" value="das" id="neutral">
                <h2>Das</h2>
            </button>
        </div>

    </form>

</div>

<!--button to return to the main menu-->
<footer>
    <form action="/" method="GET">
        <button type="submit">Regresar al inicio</button>
    </form>
</footer>

<!-- check corret answer  -->
<script>

    const wordList = JSON.parse('<%- JSON.stringify(wordList) %>');
    console.log(wordList); // verifica en Chrome que llegó bien

    const buttons = document.querySelectorAll("button");
    buttons.forEach(function (button) {
        button.addEventListener("click", function () {
            console.log(this.value);
        });
    });
</script>



