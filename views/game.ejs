<!-- Contenedor principal -->
<div class="mainDiv animate__animated animate__fadeIn">

    <!-- Show the word -->
    <div class="word">
        <h1 id="word"></h1>
    </div>

    <!-- Articles options -->
    <form class="formDiv" action="/checkAnswer" method="POST">

        <!-- first article der -->
        <div class="articleDiv">
            <button type="button" name="answer" value="der" id="maskulin">
                <h2>Der</h2>
            </button>
        </div>

        <!-- second article die -->
        <div class="articleDiv">
            <button type="button" name="answer" value="die" id="femminin">
                <h2>Die</h2>
            </button>
        </div>

        <!-- third article das -->
        <div class="articleDiv">
            <button type="button" name="answer" value="das" id="neutral">
                <h2>Das</h2>
            </button>
        </div>

    </form>

</div>

<!--button to return to the main menu-->
<footer>
    <form action="/" method="GET">
        <button type="submit">Regresar al inicio</button>
    </form>
</footer>

<!-- check corret answer  -->
<script>

    let userAnswer = null;
    let correctAnswer = null;
    let word = null;
    
    // cast the h1 element 
    const wordElement = document.getElementById("word");

    // cast the words array 
    const wordList = JSON.parse('<%- JSON.stringify(wordList) %>');

    // get a random index
    let randomIndex = Math.floor(Math.random() * wordList.length);

    // whileloop until finding a substantiv
    let itsSubstantiv = false;
    while (itsSubstantiv == false) {
        if (wordList[randomIndex].pos === "Substantiv") {
            userAnswer = null;
            // setting correct article
            correctAnswer = wordList[randomIndex].articles[0];
            // setting random word
            word = wordList[randomIndex].sch[0].lemma;
            // set the h1 to the random word 
            wordElement.innerHTML = word;
            
            itsSubstantiv = true;
        } else {
            // repet loop until getting a random index
            randomIndex = Math.floor(Math.random() * wordList.length);
        }
    }

    const buttons = document.querySelectorAll("button");
    buttons.forEach(function (button) {
        button.addEventListener("click", function () {
            userAnswer = this.value;
            
            if (userAnswer === correctAnswer){
                console.log("Its correct!");
            } else {
                console.log("Its wrong!");
            }
        });
    });
</script>
